# =============================================================================
# PayNudge — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values. The backend startup
# configuration module (backend/src/config) reads and validates these values
# and FAILS FAST if any required variable is missing or empty.
# -----------------------------------------------------------------------------

# --- Google Gemini (AI follow-up drafting) ----------------------------------
# API key for the Google Generative AI SDK (@google/generative-ai).
# Used to draft follow-up emails with the Gemini 2.5 Flash model.
# Free tier: 1,500 requests/day, no credit card required.
GOOGLE_API_KEY=your-google-generative-ai-api-key

# --- Resend (transactional email delivery) ----------------------------------
# API key for the Resend email API. Used to deliver invoice emails and
# approved follow-up emails.
RESEND_API_KEY=your-resend-api-key

# --- Supabase (Postgres database + Auth) -------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (publishable) key — used by request-scoped clients running under the
# user's Row Level Security context.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — used ONLY by trusted background jobs (overdue detection,
# draft worker). Bypasses RLS, so keep it server-side and never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Server ------------------------------------------------------------------
# Optional. Port the Express API listens on. Defaults to 4000 when unset.
PORT=4000

# --- Frontend (Next.js, browser-exposed) -------------------------------------
# These NEXT_PUBLIC_* variables are inlined into the client bundle. The anon key
# is safe to expose because all data access is guarded by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Base URL of the Express API the frontend calls (lib/api/client.ts).
# Defaults to http://localhost:4000 when unset.
NEXT_PUBLIC_API_URL=http://localhost:4000
